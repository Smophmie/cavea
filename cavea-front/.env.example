EXPO_PUBLIC_API_URL_WEB=http://localhost:8000/api
EXPO_PUBLIC_API_URL_MOBILE=http://10.0.2.2:8000/api

# Google OAuth — créer les identifiants sur https://console.cloud.google.com/apis/credentials
# Web client ID (utilisé dans Expo Go + web)
# URI de redirection autorisée à configurer : https://auth.expo.io/@<votre-username>/cavea-front
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Android client ID (empreinte SHA-1 requise dans Google Cloud Console)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS client ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
